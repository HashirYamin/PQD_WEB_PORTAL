PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# PostgreSQL connection string. The root docker-compose.yml provides this database.
DATABASE_URL=postgres://pqd_user:pqd_password@localhost:5432/pqd_portal

UPLOAD_ROOT=uploads
MAX_UPLOAD_MB=25

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PQD Portal <noreply@example.com>
